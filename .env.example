# ---- Core ----
PORT=8787
NODE_ENV=development
APP_BASE_URL=http://localhost:5173
SESSION_SECRET=change-me-long-random
# DEMO_MODE=1 enables persona launcher + sample data labels. Set 0 in production.
DEMO_MODE=1
DATA_DIR=./data
REQUIRE_STAFF_MFA=0

# ---- Payments (free test modes) ----
# Leave empty to use the built-in mock gateway. Stripe test-mode key enables Checkout Sessions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- WhatsApp (Meta Cloud API free test number, or Twilio sandbox) ----
WHATSAPP_VERIFY_TOKEN=emirattest-verify
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---- AI (optional; rules + knowledge-base fallback works without it) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Email (Resend free tier; otherwise messages are kept in the outbox table) ----
RESEND_API_KEY=
MAIL_FROM=Emirattest <no-reply@emirattest.com>
