# ===== Core =====
PORT=8787
NODE_ENV=production
APP_BASE_URL=https://your-domain.example
SESSION_SECRET=generate-with-openssl-rand-hex-32
DATA_DIR=./data
# 1 = load fictional sample people and cases on an empty database (evaluation/training only). 0 = real deployment.
DEMO_MODE=0
REQUIRE_STAFF_MFA=1
# First administrator, created on first boot when DEMO_MODE=0 (or run: npm run create-admin -w server -- you@example.org)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Comma-separated extra browser origins allowed to call the API
CORS_ORIGINS=

# ===== Payments =====
# Stripe (free test mode, then live): leave empty for bank-transfer-only
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== WhatsApp (Meta Cloud API test number, or Twilio sandbox) =====
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ===== Open-source / free-tier services =====
# LLM: any OpenAI-compatible endpoint. Ollama: http://ollama:11434/v1   Groq: https://api.groq.com/openai/v1   OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=llama3.2
# OCR (Tesseract, bundled English + Arabic data, runs offline)
OCR_ENABLED=1
OCR_LANGS=eng+ara
# ClamAV daemon (docker compose profile "full" starts one)
CLAMD_HOST=
CLAMD_PORT=3310
CLAMD_REQUIRED=0
# Email: SMTP (Mailpit for development, Brevo/Mailjet/SES/own server for production) or Resend
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=0
RESEND_API_KEY=
MAIL_FROM=Emirattest <no-reply@your-domain.example>
# Web Push (generate: npx web-push generate-vapid-keys)
VAPID_SUBJECT=mailto:support@your-domain.example
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# S3-compatible object storage for off-box copies of uploads and backups (MinIO, Cloudflare R2, Backblaze B2, Wasabi, AWS)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=emirattest/
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=14
# Single sign-on (OpenID Connect: Keycloak, Authentik, Authelia, Google, Microsoft Entra…)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://your-domain.example/api/auth/sso/callback
OIDC_LABEL=Single sign-on
OIDC_ALLOW_SIGNUP=0
# Observability
LOG_LEVEL=info
METRICS_TOKEN=
SENTRY_DSN=
# Days to keep files of closed cases
RETENTION_DAYS=730
